{
  "@context": {{ context|safe }},
  "type": {{ type|safe }},
  "id": "{{ vc_id }}",
  "name": "{{ credential_name }}",
  "issuer": {
    "type": ["CredentialIssuer"],
    "id": "{{ issuer_did }}",
    "name": "{{ name }}",
    "issuerAlsoKnownAs": {{ issuer_also_known_as|safe }}
  },
  "validFrom": "{{ issuance_date }}",
  "validUntil": "{{ valid_until }}",
  "credentialSubject": {{ credential_subject|safe }},
  "credentialSchema": {
    "type": "JsonSchema",
    "id": "{{ schema_id }}"
  }
}
